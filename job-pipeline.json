    {
      "parameters": {
        "jsCode": "// Go through every job, one at a time\nfor (const item of $input.all()) {\n  // Take the job text (or empty text if there is none)\n  let text = item.json.description || '';\n  // Turn web codes back into normal symbols: &lt; becomes <\n  text = text.replace(/&lt;/g, '<')\n    .replace(/&gt;/g, '>')      // &gt; becomes >\n    .replace(/&quot;/g, '\"')    // &quot; becomes \"\n    .replace(/&#39;/g, \"'\")     // &#39; becomes '\n    .replace(/&amp;/g, '&');    // &amp; becomes & (done last on purpose)\n  // Remove web tags like <p> or <li>, put a space instead\n  text = text.replace(/<[^>]*>/g, ' ');\n  // Some job ads are coded twice, so clean the leftover codes once more\n  text = text.replace(/&nbsp;/g, ' ')   // &nbsp; becomes a space\n    .replace(/&amp;/g, '&')             // &amp; becomes &\n    .replace(/&gt;/g, '>')              // &gt; becomes >\n    .replace(/&lt;/g, '<')              // &lt; becomes <\n    .replace(/&#?\\w+;/g, ' ');          // any other code (like &mdash;) becomes a space\n  // Squash many spaces into one, and cut spaces at the start and end\n  text = text.replace(/\\s+/g, ' ').trim();\n  // Keep only the first 6000 letters, so the AI stays cheap and focused\n  item.json.description = text.slice(0, 6000);\n}\n// Send all the cleaned jobs to the next box\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
